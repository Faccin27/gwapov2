generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model SiteContent {
  id                      String   @id @default("main")
  heroBadge               String   @default("Mais de 200 projetos entregues com sucesso")
  heroTitle               String   @default("Nós criamos sites que geram resultados")
  heroDescription         String   @default("Desenvolvemos sites modernos, rápidos e responsivos, pensados para impulsionar sua presença online e atrair mais clientes para o seu negócio.")
  heroPrimaryButtonText   String   @default("Vamos começar")
  heroPrimaryButtonLink   String   @default("https://wa.me/5549999215720")
  heroSecondaryButtonText String   @default("Ver Portfólio")
  projectsBadge           String   @default("Nosso trabalho")
  projectsTitle           String   @default("Todos os Projetos")
  projectsDescription     String   @default("Conheça os projetos que já desenvolvemos para nossos clientes.")
  footerEmail             String   @default("contact@gwapo.com.br")
  footerPhone             String   @default("(49) 99921-5720")
  footerTeamText          String   @default("Guilherme && Willian")
  footerSocialText        String   @default("Siga-nos nas redes sociais para acompanhar bastidores e novidades.")
  footerInstagramUrl      String   @default("https://instagram.com/gui.faccin")
  footerCopyright         String   @default("© 2026 Gwapo. Todos os direitos reservados.")
  seoTitle                String   @default("Gwapo | Criação de sites que geram resultados")
  seoDescription          String   @default("Criação de sites profissionais, rápidos e responsivos para gerar mais clientes. +200 projetos entregues com a Gwapo. Peça seu orçamento sem compromisso.")
  ctaTitleLine1           String   @default("Transforme sua")
  ctaTitleHighlight       String   @default("ideia em realidade")
  ctaButtonText           String   @default("Começar meu projeto")
  functionsHeading        String   @default("Todas as funções que você precisa, em um só lugar")
  seoKeywords             String   @default("")
  ogImageUrl              String   @default("")
  twitterHandle           String   @default("")
  googleSiteVerification  String   @default("")
  organizationName        String   @default("Gwapo")
  organizationDescription String   @default("Agência de desenvolvimento web que cria sites modernos, rápidos e responsivos para impulsionar a presença online e atrair mais clientes.")
  organizationLogoUrl     String   @default("/logo.png")
  robotsIndexingEnabled   Boolean  @default(true)
  contactWhatsappNumber   String   @default("5549999215720")
  contactWebhookUrl       String   @default("")
  contactQuestions        Json     @default("[]")
  updatedAt               DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  type         String
  description  String
  story        String?
  images       String[]
  technologies String[]
  url          String?
  features     String[] @default([])
  cardTools    String[] @default([])
  forSale      Boolean  @default(false)
  year         Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}
